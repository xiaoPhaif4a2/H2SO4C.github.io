{
  "name": "h2so4c-blog",
  "version": "0.0.0",
  "private": true,
  "description": "Source code for the H2SO4C personal blog.",
  "scripts": {
    "config": "node tools/generate-theme-config.cjs",
    "config:check": "node tools/generate-theme-config.cjs --check",
    "verify:categorybar": "node tools/verify-categorybar.cjs",
    "verify:plugin-removal": "node tools/verify-plugin-removal.cjs",
    "dev": "npm run build && hexo server --static",
    "build": "npm run config && hexo generate",
    "clean": "hexo clean",
    "check": "npm run clean && npm run build && npm run config:check && npm run verify:categorybar && npm run verify:plugin-removal"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "hexo": {
    "version": "8.0.0"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-butterfly-envelope": "^1.0.15",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-kramed": "^0.1.4",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.5.1",
    "js-yaml": "^4.1.0"
  }
}
