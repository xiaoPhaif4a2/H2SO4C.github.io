---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { BLOG_CATEGORIES } from "@/data/categories";
import { postFilter } from "@/utils/postFilter";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const visiblePosts = posts.filter(postFilter);
const categories = BLOG_CATEGORIES.map(category => ({
  ...category,
  count: visiblePosts.filter(post =>
    slugifyAll(post.data.categories).includes(category.slug)
  ).length,
}));
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="flex flex-wrap gap-6">
      {
        categories.map(category => (
          <li>
            <a
              href={getRelativeLocaleUrl(
                locale,
                `categories/${category.slug}/`
              )}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              {category.name}
              <span class="text-muted-foreground ms-1 text-sm">
                {category.count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
