---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import QRCode from "qrcode";
import { getShortPostId } from "@/utils/getShortPostId";
import config from "@/config";
import "@/styles/share-card.css";

type Props = { post: CollectionEntry<"posts"> };
const { post } = Astro.props;
const shortPath = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  `s/${getShortPostId(post.data.legacyPath)}/`
);
const shareUrl = new URL(shortPath, Astro.site).href;
const qrCode = await QRCode.toDataURL(shareUrl, {
  width: 176,
  margin: 4,
  errorCorrectionLevel: "M",
});
const date = new Intl.DateTimeFormat("zh-CN", {
  timeZone: post.data.timezone ?? config.site.timezone,
  dateStyle: "long",
}).format(post.data.pubDatetime);
---

<post-share
  id="post-share"
  class="share-panel"
  data-title={post.data.title}
  data-pagefind-ignore
>
  <button
    type="button"
    class="share-trigger"
    data-share-trigger
    aria-expanded="false"
    aria-controls="post-share-menu"
    hidden>分享</button
  >
  <input type="hidden" data-share-url value={shareUrl} />
  <div id="post-share-menu" class="share-menu" data-share-menu hidden>
    <div class="share-actions" role="group" aria-label="分享选项">
      <button type="button" data-copy="url">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M10 13a5 5 0 0 0 7 .2l3-3a5 5 0 0 0-7-7l-2 2M14 11a5 5 0 0 0-7-.2l-3 3a5 5 0 0 0 7 7l2-2"
          ></path></svg
        >
        分享链接
      </button>
      <button type="button" data-copy="text">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><rect x="8" y="8" width="12" height="13" rx="2"></rect><path
            d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3M11 12h6M11 16h4"
          ></path></svg
        >
        复制文案
      </button>
      <button type="button" data-generate-card>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><rect x="5" y="2" width="14" height="20" rx="2"></rect><path
            d="M9 6h6M9 10h6M8 18l3-4 3 3 2-2 3 3"></path></svg
        >
        生成长图
      </button>
    </div>
    <p data-share-status role="status" class="share-menu-status"></p>
  </div>
  <noscript><a href={shareUrl}>分享</a></noscript>

  <dialog class="share-dialog" aria-labelledby="share-dialog-title">
    <div class="share-dialog-header">
      <h2 id="share-dialog-title" class="text-lg font-bold">正文长图</h2>
      <button type="button" data-close-card autofocus>关闭</button>
    </div>
    <p class="share-hint">
      可下载图片，也可在手机上长按图片保存。长文会自动分成多张。
    </p>
    <p data-card-status role="status" class="my-3"></p>
    <div data-card-results></div>
    <button type="button" data-retry-card hidden>重新生成</button>
  </dialog>

  <template data-card-header>
    <header class="share-card-header">
      <p class="share-card-brand">{config.site.title}</p>
      <h1>{post.data.title}</h1>
      <p class="share-card-meta">{post.data.author} · {date}</p>
    </header>
  </template>
  <template data-card-footer>
    <footer class="share-card-footer">
      <div>
        <p class="share-card-brand">{config.site.title}</p>
        <p>扫码阅读全文与音视频内容</p>
        <p class="share-card-link">{shareUrl}</p>
      </div>
      <img src={qrCode} width="132" height="132" alt="原文二维码" />
    </footer>
  </template>
</post-share>

<script>
  import "@/scripts/post-share";
</script>
